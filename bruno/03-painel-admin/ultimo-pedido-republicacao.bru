meta {
  name: Último pedido de republicação
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/rest/v1/deploy_requests?select=*&order=requested_at.desc&limit=1
  body: none
  auth: bearer
}

headers {
  apikey: {{anonKey}}
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getVar('accessToken')) {
    throw new Error('Faça o login primeiro: rode "02 Autenticação > Entrar".');
  }
}

tests {
  test('status 200', function () {
    expect(res.getStatus()).to.equal(200);
  });
}

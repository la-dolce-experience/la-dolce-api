meta {
  name: Listar imagens enviadas (Storage)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/storage/v1/object/list/media
  body: json
  auth: bearer
}

headers {
  apikey: {{anonKey}}
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "prefix": "uploads/",
    "limit": 100,
    "sortBy": {
      "column": "created_at",
      "order": "desc"
    }
  }
}

script:pre-request {
  if (!bru.getVar('accessToken')) {
    throw new Error('Faça o login primeiro: rode "02 Autenticação > Entrar".');
  }
}

tests {
  test('status 200', function () {
    expect(res.getStatus()).to.equal(200);
  });
}

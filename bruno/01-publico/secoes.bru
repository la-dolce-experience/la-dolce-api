meta {
  name: Seções da página
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/rest/v1/sections?select=*&order=position
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
}

script:post-response {
  const hero = (res.getBody() || []).find((s) => s.type === 'hero');
  if (hero) bru.setVar('heroTitle', hero.title);
}

tests {
  test('status 200', function () {
    expect(res.getStatus()).to.equal(200);
  });

  test('destaque principal presente', function () {
    expect(res.getBody().map((s) => s.type)).to.include('hero');
  });
}

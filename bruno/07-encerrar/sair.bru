meta {
  name: Sair
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/v1/logout
  body: none
  auth: bearer
}

headers {
  apikey: {{anonKey}}
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getVar('accessToken')) {
    throw new Error('Faça o login primeiro: rode "02 Autenticação > Entrar".');
  }
}

script:post-response {
  bru.setVar('accessToken', '');
  bru.setVar('refreshToken', '');
}

tests {
  test('status 204', function () {
    expect(res.getStatus()).to.equal(204);
  });
}

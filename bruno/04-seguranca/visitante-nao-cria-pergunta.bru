meta {
  name: Visitante não cria pergunta
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/rest/v1/section_items
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Content-Type: application/json
}

body:json {
  {
    "section_id": "00000000-0000-4000-b000-000000000013",
    "title": "Spam?"
  }
}

tests {
  test('recusado pela política de segurança (RLS)', function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal('42501');
  });
}
